/* -*-ePiX-*- */
/* alignment_lr.c -- ePiX's reverse-LaTeX label alignment option */
#include "epix.h"
using namespace ePiX;

P p1(-1,0), p2(1,0);

int main()
{
  bounding_box(P(-1,-1), P(1,1));
  picture(P(72,24));
  unitlength("1pt");

  begin();

  font_face("tt");
  dot(p1, P(0,0), "[l]", epix_label_posn::l); 
  label(p1, P(0,0), "[r]", epix_label_posn::r); 

  dot(p2, P(0,0), "[t]", epix_label_posn::t); 
  label(p2, P(0,0), "[b]", epix_label_posn::b); 

  end();
}
