/* -*-ePiX-*- */
/* alignment.c -- ePiX's reverse-LaTeX label alignment option */
#include "epix.h"
using namespace ePiX;

P O(0,0);

int main()
{
  bounding_box(P(-1,-1), P(1,1));
  picture(P(72,24));
  unitlength("1pt");

  begin();

  Line(O, E_1);
  Line(O, E_2);

  font_face("tt");
  dot(O, P(0,0), "[tr]", epix_label_posn::tr); 
  label(O, P(0,0), "[tl]", epix_label_posn::tl);
  label(O, P(0,0), "[br]", epix_label_posn::br);
  label(O, P(0,0), "[bl]", epix_label_posn::bl);

  end();
}
