/* -*-ePiX-*- */
#include "epix.h"
using namespace ePiX;

int main() 
{
  bounding_box(P(-2,-1),P(2,1));
  unitlength("1in");
  picture(1.5,0.75);

  begin();
  revolutions();

  h_axis(4);
  v_axis(1);

  bold();
  plot(sinx, x_min, x_max, 60);

  label(P(0,y_min), P(0,-4), "\\code{sinx}", epix_label_posn::b);

  end();
}
