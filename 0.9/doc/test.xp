/* -*-ePiX-*- */
#include <iostream>
#include <string>
#include <cmath>

#include "epix.h"

#define FISHEYE_DEMO
// #define BOX_DEMO
// #define CROSS_PRODUCT_DEMO
// #define DALI_DEMO
// #define TESS_DEMO

namespace ePiX3d {

  using std::cout;

  epix3d_style current;
  epix3d_camera camera;

  void grid(int N1, int N2)
  {
    for (int i=0; i <= N1; ++i)
      for (int j=0; j <= N2; ++j)
	{
	  if ( i < N1 )
	    {
	      cout << "\n\\path";
	      print(P(i*1.0/N1, j*1.0/N1,0));
	      print(P((i+1)*1.0/N1, j*1.0/N1,0));
	    }
	  if ( j < N2 )
	    {
	      cout << "\n\\path";
	      print(P(i*1.0/N1, j*1.0/N1,0));
	      print(P(i*1.0/N1, (j+1)*1.0/N1,0));
	    }
	}
  }

  void cube(P corner)
  {
    //    double Dist=camera.get_range();
    cout << "\n\\color[rgb]{0,0,1}";
    cout << "\n\\path";
    print(corner + V(corner,  1, 1, 1));
    print(corner + V(corner,  1, 1,-1));
    
    cout << "\n\\path";
    print(corner + V(corner, -1, 1, 1));
    print(corner + V(corner, -1, 1,-1));

    cout << "\n\\path";
    print(corner + V(corner, -1,-1, 1));
    print(corner + V(corner, -1,-1,-1));

    cout << "\n\\path";
    print(corner + V(corner,  1,-1, 1));
    print(corner + V(corner,  1,-1,-1));

    cout << "\n\\color[rgb]{0,1,0}";
    cout << "\n\\path";
    print(corner + V(corner, -1, 1, 1));
    print(corner + V(corner, -1,-1, 1));

    cout << "\n\\path";
    print(corner + V(corner, -1, 1,-1));
    print(corner + V(corner, -1,-1,-1));

    cout << "\n\\path";
    print(corner + V(corner,  1, 1,-1));
    print(corner + V(corner,  1,-1,-1));

    cout << "\n\\path";
    print(corner + V(corner,  1, 1, 1));
    print(corner + V(corner,  1,-1, 1));

    cout << "\n\\color[rgb]{1,0,0}";
    cout << "\n\\path";
    print(corner + V(corner,  1, 1, 1));
    print(corner + V(corner, -1, 1, 1));

    cout << "\n\\path";
    print(corner + V(corner,  1,-1, 1));
    print(corner + V(corner, -1,-1, 1));

    cout << "\n\\path";
    print(corner + V(corner,  1,-1,-1));
    print(corner + V(corner, -1,-1,-1));

    cout << "\n\\path";
    print(corner + V(corner,  1, 1,-1));
    print(corner + V(corner, -1, 1,-1));

    cout << "\n";
  }

  void box(P corner1, P corner2)
  {
    V diag = corner2 - corner1;

    //    double Dist=camera.get_range();
    cout << "\n\\path";
    print(corner1 + (diag&V(1,1,1)));
    print(corner1 + (diag&V(1,1,0)));
    
    cout << "\n\\path";
    print(corner1 + (diag&V(0,1,1)));
    print(corner1 + (diag&V(0,1,0)));

    cout << "\n\\path";
    print(corner1 + (diag&V(0,0,1)));
    print(corner1 + (diag&V(0,0,0)));

    cout << "\n\\path";
    print(corner1 + (diag&V(1,0,1)));
    print(corner1 + (diag&V(1,0,0)));

    cout << "\n\\path";
    print(corner1 + (diag&V(0,1,1)));
    print(corner1 + (diag&V(0,0,1)));

    cout << "\n\\path";
    print(corner1 + (diag&V(0,1,0)));
    print(corner1 + (diag&V(0,0,0)));

    cout << "\n\\path";
    print(corner1 + (diag&V(1,1,0)));
    print(corner1 + (diag&V(1,0,0)));

    cout << "\n\\path";
    print(corner1 + (diag&V(1,1,1)));
    print(corner1 + (diag&V(1,0,1)));

    cout << "\n\\path";
    print(corner1 + (diag&V(1,1,1)));
    print(corner1 + (diag&V(0,1,1)));

    cout << "\n\\path";
    print(corner1 + (diag&V(1,0,1)));
    print(corner1 + (diag&V(0,0,1)));

    cout << "\n\\path";
    print(corner1 + (diag&V(1,0,0)));
    print(corner1 + (diag&V(0,0,0)));

    cout << "\n\\path";
    print(corner1 + (diag&V(1,1,0)));
    print(corner1 + (diag&V(0,1,0)));

    cout << "\n";
  } // end of box

  void shade_box(P corner1, P corner2)
  {
    V diag = corner2 - corner1;

    //    double Dist = camera.get_range();

    cout << "\n\\path";
    print(corner1 + (diag&V(corner1, 1,1,1)));
    print(corner1 + (diag&V(corner1, 1,1,0)));
    
    cout << "\n\\path";
    print(corner1 + (diag&V(corner1, 0,1,1)));
    print(corner1 + (diag&V(corner1, 0,1,0)));

    cout << "\n\\path";
    print(corner1 + (diag&V(corner1, 0,0,1)));
    print(corner1 + (diag&V(corner1, 0,0,0)));

    cout << "\n\\path";
    print(corner1 + (diag&V(corner1, 1,0,1)));
    print(corner1 + (diag&V(corner1, 1,0,0)));

    cout << "\n\\path";
    print(corner1 + (diag&V(corner1, 0,1,1)));
    print(corner1 + (diag&V(corner1, 0,0,1)));

    cout << "\n\\path";
    print(corner1 + (diag&V(corner1, 0,1,0)));
    print(corner1 + (diag&V(corner1, 0,0,0)));

    cout << "\n\\path";
    print(corner1 + (diag&V(corner1, 1,1,0)));
    print(corner1 + (diag&V(corner1, 1,0,0)));

    cout << "\n\\path";
    print(corner1 + (diag&V(corner1, 1,1,1)));
    print(corner1 + (diag&V(corner1, 1,0,1)));

    cout << "\n\\path";
    print(corner1 + (diag&V(corner1, 1,1,1)));
    print(corner1 + (diag&V(corner1, 0,1,1)));

    cout << "\n\\path";
    print(corner1 + (diag&V(corner1, 1,0,1)));
    print(corner1 + (diag&V(corner1, 0,0,1)));

    cout << "\n\\path";
    print(corner1 + (diag&V(corner1, 1,0,0)));
    print(corner1 + (diag&V(corner1, 0,0,0)));

    cout << "\n\\path";
    print(corner1 + (diag&V(corner1, 1,1,0)));
    print(corner1 + (diag&V(corner1, 0,1,0)));

    cout << "\n\\special{sh " << current.gray_depth << "}%%";
    cout << "\n\\shade\\path";
    print(corner1 + (diag&V(corner1, 1,0,0)));
    print(corner1 + (diag&V(corner1, 1,1,0)));
    print(corner1 + (diag&V(corner1, 1,1,1)));
    print(corner1 + (diag&V(corner1, 1,0,1)));
    print(corner1 + (diag&V(corner1, 1,0,0)));
  
    cout << "\n";
  } // end of box

} /* end of namespace ePiX3d */

using namespace ePiX3d;

#ifdef FISHEYE_DEMO
const int N=10;
double ht(double x, double y)
{
  // redefine to 0 for coordinate grid
  return 0.025*((x-N)*(x-N)-(y-N)*(y-N));
}
#endif

main()
{

  /* fisheye lens, and other camera tricks */
#ifdef FISHEYE_DEMO

  picture(P(240,240));
  unitlength("0.75mm");
  bounding_box(P(-2,-2), P(2,2));
  camera.range(12);

  begin();

  degrees();

  camera.look_at(P(N,N,0));

  camera.lens(fisheye);
  camera.rotate_sea(-60);
  camera.rotate_sky(30);

  label label_table[4*N*N];

  cout << "\n\\color[rgb]{1,0,0}%%"; // red
  for (int i=0; i<2*N; ++i)
    for (int j=0; j<2*N; ++j)
      label_table[2*N*i+j] = marker(P(i,j, ht(i,j)), H_TICK);

  for (int i=0; i<2*N; ++i)
    for (int j=0; j<2*N; ++j)
      {
	print(label_table[2*N*i+j]);
	cout << "\n\\path" 
	     << c2p(camera.shoot(P(i+1,j, ht(i+1,j))))
	     << c2p(camera.shoot(P(i,j, ht(i,j)))) 
	     << c2p(camera.shoot(P(i,j+1, ht(i, j+1))));
      }

#endif /* FISHEYE_DEMO */

  /* shaded boxes*/
#ifdef BOX_DEMO
  const int N=4;

  picture(P(240,240));
  unitlength("0.75mm");
  bounding_box(P(-10,-10), P(10,10));
  camera.range(15);

  begin();

  degrees();

  camera.rotate_sky(35);
  camera.rotate_sea(-15);

  for (int i=0; i<= N; ++i)
    {
      gray(0.15*i);
      shade_box(P(-1,-2,-(1+2*i)), P(1,1,1-2*i));
    }

#endif /* BOX_DEMO */

#ifdef CROSS_PRODUCT_DEMO
  picture(P(240,240));
  unitlength("0.75mm");
  bounding_box(P(-10,-10), P(10,10));
  camera.range(0);

  begin();

  /*
    camera.rotate_sky(-M_PI/4);
    camera.rotate_sea(ePiX3d::acos(sqrt(2.0/3)));
  */

  V vec3 = (1/sqrt(2))*V(1,1,1);
  V vec1 = (1/sqrt(3))*V(1,1,1);
  V vec2 = V(1,0,0);
  P O;

  std::cout << "\n\\path";
  print(O);
  for (int i=0; i < 5; ++i)
    {
      print(O+vec2);
      vec2 *= vec1;
    }

  vec3 = (1/sqrt(2))*V(1,1,1);
  vec1 = (1/sqrt(3))*V(1,1,1);
  vec2 = V(1,0,0);

  std::cout << "\n\\thicklines\\path";

  print(O);
  for (int i=0; i < 9; ++i)
    {
      print(O+vec2);
      vec2 *= vec3;
    }

  //  degrees();

  //  current.screen_projection = fisheye;
  //  camera.rotate_sea(80);
  //  camera.rotate_sky(75);

  //  grid(10,10);

  /*
    degrees();
    gray(0.05);

    camera.rotate_sky(35);
    camera.rotate_sea(15);


    std::cout << "\n\\put";
    print((P(-1,-1,-1)));
    std::cout << "{\\makebox(0,0){$\\bullet$}}";

    std::cout << "\n\\put";
    print(P(1,1,1));
    std::cout << "{\\makebox(0,0){$\\bullet$}}";

    shade_box(P(-1,-1,-1), P(1,1,1));
  */

#endif /* CROSS_PRODUCT_DEMO

  /* Corpus hypercubus */
#ifdef DALI_DEMO
  picture(P(300,200));
  unitlength("0.5mm");
  bounding_box(P(-5,-5), P(10,5));
  camera.range(16);

  begin();

  camera.rotate_sky(M_PI/12);
  camera.rotate_sea(M_PI/6);
  //  camera.rotate_eye(-10);

  for (int k=-4; k <= 4; k +=4)
    {
      cube(P(k,0,0));
      cube(P(0,-k,0));
      cube(P(0,0,k));
    }

  cube(P(0,-8,0));

  cout << "\n\\allinethickness{2pt}%";
  cube(P(0,0,0));
#endif /* DALI_DEMO */

#ifdef TESS_DEMO
  picture(P(300,300));
  unitlength("1pt");
  bounding_box(P(-2,-2), P(2,2));

  begin();

  camera.rotate_sky(M_PI/12);
  camera.rotate_sea(M_PI/16);
  camera.rotate_eye(M_PI/6);

  const int M=20;
  for (int k=0; k<M; ++k)
    {

      camera.rotate_sky(0.75/M);
      camera.rotate_sea(1.5/M);
      camera.rotate_eye(1.250/M);

      cout << "\\color[rgb]{" 
	   << k*1.0/M << ",0," << truncate(1-k*1.0/M) << "}";

      camera.range(3+0.1*k);

    if (k == M-1)
      cout << "\\allinethickness{1.5pt}\n";

    cube(P(0,0,0));
    }
#endif /* TESS_DEMO */

  end();
}
