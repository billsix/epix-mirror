#!/bin/bash
#
# make_elaps -- Generates shell script "elaps" from config
#
# Andrew D. Hwang <"elaps -v" for email>
#
# May 07, 2005
#

## Don't modify anything below unless you know what you're doing :) ##

ELAPS_WRAPPER=elaps

source ./config || ( echo "Can't find config file" && exit 1 )

## Unquoted HERE document ##
cat <<HEADER > $ELAPS_WRAPPER
#!/bin/bash
# 
# elaps: Convert an epix file to encapsulated Postscript, i.e. epix2eps
# 
# Options: --help for usage, --version for version and license
#
# Compiler flags may be specified on the command line or in the config
# file ~/.epixrc. The script attempts to deal intelligently with missing
# or multiple extensions. If the input file has a recognized extension,
# there's no issue. If only the root name <infile> is given, the script
# searches for completions in the order of preference dictated by the
# variable EPIX_EXTENSIONS. A warning is issued for multiple matches.
#
# Copyright (C) 2001, 2002, 2003, 2004, 2005
# Andrew D. Hwang   <For address, do "elaps -v">
# 

## Auto-generated file; modify as necessary ##

EPIX_BIN=$EPIX_ROOTDIR/bin/epix

HEADER
# End of header

# Common functions
cat epix_functions >> $ELAPS_WRAPPER

# Now for phase two...
cat <<"EOF" >> $ELAPS_WRAPPER
PROG=$(basename $0)

## Nothing below here should need modification ##

EPIX_CONFIG_FILE="$HOME/.epixrc"
# Search these extensions in order of preference
ELAPS_EXTENSIONS="eepic xp flx cc c C cpp" # or NULL
ELAPS_DOT_EXT=".${ELAPS_EXTENSIONS// /|.}" # for usage message

# default options
DVIPS_OPTS="-f"
ELAPS_PKGS="latexsym,amsmath,rotating,epic,eepic,pstcol"
ELAPS_SIZE=12 # figure compiled in [12pt]{article}

PS2EPS=ps2epsi

# internal filenames
PID=$$
ELAPS_TEMP_EEPIC=$PROG-$PID.eepic
ELAPS_TEMP_LATEX=$PROG-$PID.tex
ELAPS_TEMP_DVI=$PROG-$PID.dvi
ELAPS_TEMP_PS=$PROG-$PID.ps
ELAPS_TEMP_EPSI=$PROG-$PID.epsi

ELAPS_INFILE=""
ELAPS_INROOT=""
ELAPS_OUTROOT=""

ELAPS_PDF="no"    # Create PDF file?
ELAPS_PS="no"     # Create PS file instead of EPS?

ELAPS_STDERR=/dev/null # Pipe stderr here
ELAPS_VERBOSE="no"
EPIX_OPTS=""


function elaps_help()
{
cat <<"HELP" >&1
    -vv, --verbose
      Show output/error messages, or license (before -v)

    -P<printer>
      dvips printer options, e.g. "-Pamz", may be given on the command 
      line. They are also read from ~/.dvipsrc if this file exists.

    -p, --pkg <LaTeX package>
      Use an additional LaTeX package in the temporary LaTeX file, e.g. 
      "-p floatflt". Multiple packages are specified one per "-p" flag.

    -pdf, --pdf
      Create PDF file instead of EPS

    -ps, --ps
      Create standalone PostScript file (overrides --pdf)

    -o|--output
      Specify output file (ONLY for use with a single input file)

    -n, --no-config
      Ignore $(HOME)/.dvipsrc

    --size
      Set default font size: 10, 11, or 12 (default)

    Other options are passed to epix (q.v.).

HELP
} # End of elaps_help

# Generate LaTeX file
function elaps_make_latex ()
{
cat <<LaTeX >> $1
\documentclass[${2}pt]{article}
\usepackage{$3}
\pagestyle{empty}

\begin{document}
\begin{center}
\input{$4}
\end{center}
\end{document}

LaTeX
} # End of elaps_make_latex


function elaps_process_files ()
{
    # Parse command line options
    while [ "$1" != "${1#"-"}" ]; do 
        case "$1" in

        -vv|--verbose)
            ELAPS_VERBOSE="yes"
            ELAPS_STDERR=/dev/stderr
            shift;
            ;;

        -h|--help)
	    ePiX_basic_help $ELAPS_DOT_EXT && elaps_help && exit 0
	    ;;

        -v|--version)
            ePiX_version &&
            if [ "$ELAPS_VERBOSE" = "yes" ]; then 
                ePiX_license
            else
                echo "$PROG --verbose -v\" for license" 
            fi && 
            exit 0
	    ;;

        -n|--no-config) # do not use ~/.dvipsrc
            export DVIPSRC=/dev/null
            shift;
            ;;

        -P*)
            DVIPS_OPTS="$1 $DVIPS_OPTS";
            shift;
            ;;

        -p|--pkg)
            if [ "$2" != "${2#"-"}" -o "$2" = "" ]; then
                elaps_warn "\"$1\" cannot be followed by \"$2\"; skipping"
                shift 1;
            else
                ELAPS_PKGS="$ELAPS_PKGS,$2"
                echo "$PROG: Using LaTeX package \"$2\"" > $ELAPS_STDERR
                shift 2;
            fi
            ;;

        -pdf|--pdf)
            ELAPS_PDF="yes"
            echo "$PROG: Creating PDF file" > $ELAPS_STDERR
            shift;
            ;;

        -ps|--ps)
            ELAPS_PS="yes"
            echo "$PROG: Creating PS file" > $ELAPS_STDERR
            shift;
            ;;

        -p*)
            ELAPS_NEW_PKG=${1#"-p"}
            ELAPS_PKGS="$ELAPS_PKGS,$ELAPS_NEW_PKG"
            echo "$PROG: Using LaTeX package \"$ELAPS_NEW_PKG\"" >$ELAPS_STDERR
            shift;
            ;;

        -o|--output)
            if [ $2 = ${2%%"eps"}eps ]; then
                ELAPS_OUTROOT=${2%%".eps"}

            elif [ $2 = ${2%%"pdf"}pdf ]; then
                ELAPS_PDF="yes" 
                ELAPS_OUTROOT=${2%%".pdf"}

            else
                ELAPS_OUTROOT=$2
            fi
            shift 2;
            ;;

        --size)
            ELAPS_SIZE=$2
            shift 2;
            ;;

        # pass other options to epix
        -V|-i*|-u|-x|-I|-L|-l|-W)
	    EPIX_OPTS="$EPIX_OPTS $1 $2";
            shift 2;
            ;;

        -b) 
            ePiX_warn "Skipping option \"$1 $2\""
            shift 2;
            ;;

        *)
            EPIX_OPTS="$EPIX_OPTS $1";
            shift;
            ;;
        esac
    done

    # Create temporary directory
    PID=$$
    ELAPS_TEMPDIR=/tmp/$PROG-$PID
    mkdir $ELAPS_TEMPDIR || ePiX_die "Can't create $ELAPS_TEMPDIR"


    # Assume remaining parameters are input files
    INFILE_LIST=$@
    INFILE_COUNT=$#

    if [ "$INFILE_LIST" = "" ]; then ePiX_die "No input file specified"; fi

    for ELAPS_INFILE in $(echo $INFILE_LIST); do

        if [ "$ELAPS_VERBOSE" = "yes" ]; then echo "$ELAPS_INFILE"; fi

        FOUND_CT=0
        FOUND_EXT=""

    # Parse input file name; pass basename.ext to epix
        for EXT in $ELAPS_EXTENSIONS; do
            TMP_ROOT=${ELAPS_INFILE%%".$EXT"}
            if [ $ELAPS_INFILE = $TMP_ROOT.$EXT ]; then
                ELAPS_INROOT=$TMP_ROOT && FOUND_EXT=$EXT && break;
            fi
        done

        # No recognized extension provided
        if [ "$FOUND_EXT" = "" ]; then
            if [ $INFILE_COUNT -gt 1 ]; then
                ePiX_warn "Skipping $ELAPS_INFILE"
                continue
            fi
            ELAPS_INROOT=$ELAPS_INFILE

            # Search for (and count) completions; first match wins
            for EXT in $ELAPS_EXTENSIONS; do
                if [ -f $ELAPS_INROOT.$EXT ]; then 
                    if [ $FOUND_CT -eq 0 ]; then
                        ELAPS_INFILE=$ELAPS_INROOT.$EXT && FOUND_EXT=$EXT
                    fi

                    let FOUND_CT=FOUND_CT+1
                fi
            done

            if [ $FOUND_CT -eq 0 ]; then
                ePiX_warn "No completion of \"$ELAPS_INROOT\" found"
                continue

            elif [ $FOUND_CT -ge 2 ]; then
                ePiX_warn "Found $FOUND_CT completions of \"$ELAPS_INROOT\", using $ELAPS_INFILE"

            # else one file found, ELAPS_INFILE already set
            fi

            # Check for putative input file if $EXT != ""
            elif [ ! -f $ELAPS_INROOT.$EXT ]; then
                ePiX_warn "\"$ELAPS_INROOT.$EXT\" not found"
                continue

        fi # if $FOUND_EXT=""

        if [ "$ELAPS_OUTROOT" = "" ]; then ELAPS_OUTROOT=$ELAPS_INROOT; fi

        # Create eepic file if necessary
        if [ "$FOUND_EXT" != "eepic" ]; then 
            if [ "$FOUND_EXT" != "" ]; then FOUND_EXT=".$FOUND_EXT"; fi
            $EPIX_BIN $EPIX_OPTS -o $ELAPS_TEMP_EEPIC \
                ${ELAPS_INROOT}${FOUND_EXT} 2> $ELAPS_STDERR

        elif [ -f $ELAPS_INFILE ]; then
            ln -s $ELAPS_INFILE $ELAPS_TEMP_EEPIC

        else
            ePiX_warn "$ELAPS_INFILE not found"; continue

        fi

        elaps_make_latex $ELAPS_TEMP_LATEX $ELAPS_SIZE $ELAPS_PKGS \
            $ELAPS_TEMP_EEPIC

        # Create $ELAPS_TEMP_PS
        latex $ELAPS_TEMP_LATEX 1>$ELAPS_STDERR
        dvips $DVIPS_OPTS -o $ELAPS_TEMP_PS $ELAPS_TEMP_DVI &>$ELAPS_STDERR

        if [ "$ELAPS_PS" = "yes" ]; then
            # fix title
            sed "s/$PROG-$PID/$ELAPS_INROOT/g" \
                $ELAPS_TEMP_PS > $ELAPS_OUTROOT.ps
        else
            # Create eps file,
            $PS2EPS $ELAPS_TEMP_PS 1> $ELAPS_STDERR

            # fix title,
            sed "s/$PROG-$PID/$ELAPS_INROOT/g" \
                $ELAPS_TEMP_EPSI > $ELAPS_OUTROOT.eps &&
            rm $ELAPS_TEMP_EPSI

            # create pdf if requested,
            if [ "$ELAPS_PDF" = "yes" ]; then
                # avoid ghostscript rotation bug
                grep -v "^%%Orientation:" $ELAPS_OUTROOT.eps | \
                    epstopdf --filter --outfile=$ELAPS_OUTROOT.pdf
                rm $ELAPS_OUTROOT.eps # clean up eps
            fi
        fi

        # and clean up
        rm  $ELAPS_TEMP_LATEX $ELAPS_TEMP_DVI $ELAPS_TEMP_PS \
            $ELAPS_TEMP_EEPIC $PROG-$PID.aux $PROG-$PID.log

        ELAPS_OUTROOT=""

    done # for ELAPS_INFILE in $INFILE_LIST

} # elaps_process_files()

## Script proper starts here ##

if [ $# -eq 0 ]; then 
    ePiX_basic_help $ELAPS_DOT_EXT && elaps_help && exit 0

else
    # Command line options
    elaps_process_files $@

fi

# clean up
rm -Rf $ELAPS_TEMPDIR
EOF

chmod 700 $ELAPS_WRAPPER
## end of script ##
