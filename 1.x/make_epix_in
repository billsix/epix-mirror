PROG=$(basename $0)

## Nothing below here should need modification ##

EPIX_CONFIG_FILE="$HOME/.epixrc"
# Search these extensions in order of preference
EPIX_EXTENSIONS="xp flx cc c C cpp" # or NULL
EPIX_DOT_EXT=".${EPIX_EXTENSIONS// /|.}" # for usage message

# Path to standard header and library
HDR_PATH=$INSTALL_DIR/include
LIB_PATH=$INSTALL_DIR/lib

# Default inc/lib directories
DEFAULT_INC="-I$HDR_PATH"
DEFAULT_LIB="-L$LIB_PATH"

# Use default library unless we're called by version number
LIBS="-lm -lepix"
EPIX_SRC_EXT=cc

declare EPIX_MYINCLUDES
declare EPIX_MYLIBDIRS
declare EPIX_MYLIBS
declare EPIX_MYWARNS
declare EPIX_MYFLAGS

EPIX_STDERR=/dev/null

EPIX_INFILE=""
EPIX_INROOT=""
EPIX_OUTROOT=""

EPIX_VERBOSE="no"
EPIX_PID=$$

function epix_help()
{
cat <<"HELP" >&1
Options:
    -h, --help
      Show this message and exit

    -v, --version
      Show version and exit

    -vv, --verbose
      Show error messages

    --gpl
      Show license

    -o, --output
      Specify output file (ONLY for use with a single input file)

    -I<include>
      Append include directory

    -L<library>
      Append library directory

    -l<lib>
      Link against lib

    --no-defaults
      Do not use default include/library directories

    -cc|--compiler)
      Specify the compiler (e.g., gcc)

    All other options are passed to the compiler. Valid options, 
    one per line, may be placed in $HOME/.epixrc. 

HELP
} # End of epix_help


# Parse command line/config file for compiler flags/options
function epix_parse_options {
while [ "$1" != "${1#"-"}" ]; do
    case "$1" in

    -I)
	EPIX_MYINCLUDES="$EPIX_MYINCLUDES -I$2"; shift 2; continue
	;;

    -L)
	EPIX_MYLIBDIRS="$EPIX_MYLIBDIRS -L$2"; shift 2; continue
	;;

    -l)
	EPIX_MYLIBS="$EPIX_MYLIBS -l$2"; shift 2; continue
	;;

    -W)
	EPIX_MYWARNS="$EPIX_MYWARNS -W$2"; shift 2; continue
	;;

    -I*)
	EPIX_MYINCLUDES="$EPIX_MYINCLUDES $1"; shift; continue
	;;

    -L*)
	EPIX_MYLIBDIRS="$EPIX_MYLIBDIRS $1"; shift; continue
	;;

    -l*)
	EPIX_MYLIBS="$EPIX_MYLIBS $1"; shift; continue
	;;

    -W*)
	EPIX_MYWARNS="$EPIX_MYWARNS $1"; shift; continue
	;;

    -V|-i*|-u|-x)
	EPIX_MYFLAGS="$EPIX_MYFLAGS $1 $2"; shift 2; continue
	;;

    -b) 
	ePiX_warn "Skipping option \"$1 $2\""
	shift 2; continue
	;;

    -o|--output)
        EPIX_OUTFILE=$2
      	EPIX_OUTROOT=${EPIX_OUTFILE%%".eepic"}
        shift 2; continue
        ;;

    -vv|--verbose)
        EPIX_VERBOSE="yes"
        EPIX_STDERR=/dev/stderr
        shift; continue
        ;;

    -h|--help)
	ePiX_usage $EPIX_DOT_EXT && epix_help && exit 0
	;;

    --gpl)
        ePiX_version
        ePiX_license
        exit 0
        ;;

    -v|--version)
	ePiX_version && 
        if [ "$EPIX_VERBOSE" = "yes" ]; then 
            ePiX_license
        else
            echo "\"$PROG --gpl\" for license" 
        fi && 
        exit 0
	;;

    --no-defaults)
        LIBS="-lm"
        shift; continue
        ;;

    -cc|--compiler)
        COMPILER=$2
        COMP_NAME=$(basename $COMPILER)
        if [ ${COMP_NAME:$((-2))} = cc ]; then EPIX_SRC_EXT=c; fi
        shift 2; continue
        ;;

    *)
	EPIX_MYFLAGS="$EPIX_MYFLAGS $1"; shift; continue
	;;
    esac
done
} # End of epix_parse_options


# get file's root name, assuming extension is in $EPIX_EXTENSIONS,
# and compile to eepic
function epix_compile_files {
# Skip options
while [ "$1" != "${1#"-"}" ]; do 
    case "$1" in

    -V|-b|-i*|-o|-u|-x|-I|-L|-l|-W|-cc|--compiler)

	shift 2;
	;;

    *)
	shift;
	;;
    esac
done
    # Assume remaining parameters are input files
    INFILE_LIST=$@

    if [ "$INFILE_LIST" = "" ]; then ePiX_die "No input file specified"; fi

    for EPIX_INFILE in $(echo $INFILE_LIST); do

        if [ "$EPIX_VERBOSE" = "yes" ]; then echo "$EPIX_INFILE"; fi

        FOUND_CT=0
        FOUND_EXT=""

        for EXT in $EPIX_EXTENSIONS; do
            TMP_ROOT=${EPIX_INFILE%%".$EXT"}
	    if [ $EPIX_INFILE = $TMP_ROOT.$EXT ]; then
                EPIX_INROOT=$TMP_ROOT && FOUND_EXT=$EXT && break;
            fi
        done

        # No recognized extension provided
        if [ "$FOUND_EXT" = "" ]; then
	    EPIX_INROOT=$EPIX_INFILE

            # Search for (and count) completions; first match wins
            for EXT in $EPIX_EXTENSIONS; do
	        if [ -f $EPIX_INROOT.$EXT ]; then 
	            if [ $FOUND_CT -eq 0 ]; then
		        EPIX_INFILE=$EPIX_INROOT.$EXT;
		    fi

		    let FOUND_CT=FOUND_CT+1
                fi
	    done

 	    if [ $FOUND_CT -eq 0 ]
	    then
	        ePiX_warn "No completion of \"$EPIX_INROOT\" found"
                continue

	    elif [ $FOUND_CT -ge 2 ]
	    then
                ePiX_warn "Found $FOUND_CT completions of \"$EPIX_INROOT\", using $EPIX_INFILE"

            # else one file found, EPIX_INFILE already set
	    fi

        # Check for putative input file if $EXT != ""
        elif [ ! -f $EPIX_INROOT.$EXT ]; then
            ePiX_warn "\"$EPIX_INROOT.$EXT\" not found"
            continue

        fi # if $FOUND_EXT=""

        if [ "$EPIX_OUTROOT" = "" ]; then
	    EPIX_OUTROOT=$EPIX_INROOT
        fi

        # Give temporary binary a unique name (securely if possible...)
        TEMP_BIN=$(mktemp -q /tmp/epix-${EPIX_PID}_XXXXXX 2>/dev/null)
        if [ $? -ne 0 ]; then # No mktemp...?
            TEMP_BIN=/tmp/$EPIX_INROOT-${EPIX_PID} &&
            touch $TEMP_BIN
        fi

        # Create symlink to input file with appropriate extension for compiler
        EPIX_TEMP_INPUT=epix-${EPIX_PID}.$EPIX_SRC_EXT
        ln -s $EPIX_INFILE $EPIX_TEMP_INPUT

        # Compile executable (temporary binary written in cwd)
        $COMPILER $EPIX_TEMP_INPUT $EPIX_MYWARNS -o $TEMP_BIN $EPIX_MYFLAGS \
            $EPIX_MYINCLUDES $DEFAULT_INC $EPIX_MYLIBDIRS $DEFAULT_LIB \
            $LIBS $EPIX_MYLIBS &>$EPIX_STDERR

        # Write eepic file
        if [ -x "$TEMP_BIN" ]; then 
            echo "%% Generated from $EPIX_INFILE on $(date) by" > $EPIX_OUTROOT.eepic
            $TEMP_BIN >> $EPIX_OUTROOT.eepic

            if [ ! -f "$EPIX_OUTROOT.eepic" ]; then
                ePiX_warn "Could not create $EPIX_OUTROOT.eepic"
            fi

        else
            ePiX_warn "Compilation of $EPIX_INFILE failed"

        fi

        # Clean up; for multiple input files, clear output name
        rm -f $TEMP_BIN $EPIX_TEMP_INPUT
        EPIX_OUTROOT=""

    done # for EPIX_INFILE in $INFILE_LIST

# clean up
} # end of epix_compile_files

## Script proper starts here ##

if [ $# -eq 0 ]; then 
    ePiX_usage $EPIX_DOT_EXT && epix_help && exit 0

else
    # Command line options
    epix_parse_options $@

    # Append options from the config file, if any
    if [ -f $EPIX_CONFIG_FILE ]; then
	for line in $(cat $EPIX_CONFIG_FILE | grep -v "#"); do
	    epix_parse_options $line
	done
    fi

    # Suppress all warnings if none are requested
    if [ "$EPIX_MYWARNS" = "" ]; then EPIX_MYWARNS="-w"; fi

    # Remaining option(s) assumed to be input file(s)
    epix_compile_files $@

fi

exit 0
