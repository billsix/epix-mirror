LDFLAGS = @LDFLAGS@
LIBS = @LIBS@
libepix_a_DEPENDENCIES =  camera.o circle.o cropping.o curves.o \
dataplot.o domain.o functions.o geometry.o Label.o lengths.o objects.o \
output.o path.o plane.o plots.o polyhedron.o segment.o sphere.o \
triples.o
libepix_a_OBJECTS =  camera.o circle.o cropping.o curves.o dataplot.o \
domain.o functions.o geometry.o Label.o lengths.o objects.o output.o \
path.o plane.o plots.o polyhedron.o segment.o sphere.o triples.o
