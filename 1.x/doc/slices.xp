/* -*-ePiX-*- */
#include "epix.h"
using namespace ePiX;

int main() 
{
  bounding_box(P(0,0),P(8,2));
  unitlength("1in");
  picture(5,0.75);

  begin();

  grid(P(0,0), P(2,2), 12, 8);
  label(P(1,0), P(0,-4), "\\code{R}", b);

  /*
  dashed();
  grid(P(3,0), P(5,2), mesh(1, 1), mesh(6,4));
  grid(P(6,0), P(8,2), mesh(1, 1), mesh(6,4));

  solid();
  */
  bold();
  for (int i=0; i<= 12; ++i)
    line(P(3+i*1.0/6, 0),P(3+i*1.0/6, 2));

  label(P(4,0), P(0,-4), "\\code{R.slices1()}", b);

  for (int i=0; i<= 8; ++i)
    line(P(6, i*1.0/4), P(8, i*1.0/4));

  label(P(7,0), P(0,-4), "\\code{R.slices2()}", b);

  end();
}
