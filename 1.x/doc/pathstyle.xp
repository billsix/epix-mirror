/* -*-ePiX-*- */
#include "epix.h"
using namespace ePiX;

double my_stretch = 0.3;

int main() {
  bounding_box(P(0,-0.5),P(10,0));
  unitlength("0.5in");
  picture(P(10,0.5));

  begin();

  bold();
  dot(P(0,0));
  dot(P(1,0));
  dot(P(2,0));
  line(P(0,0), P(2,0));
  label(P(1,0), P(0,-6), "Solid", b);

  dot(P(4,0));
  dot(P(5,0));
  dot(P(6,0));
  line(P(4,0), P(4+my_stretch,0));
  line(P(5-my_stretch,0), P(5+my_stretch,0));
  line(P(6-my_stretch,0), P(6,0));

  label(P(5,0), P(0,-6), "Dashed", b);

  dot(P(8,0));
  dot(P(9,0));
  dot(P(10,0));
  label(P(9,0), P(0,-6), "Dotted", b);

  end();
}
