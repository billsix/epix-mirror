/* -*-ePiX-*- */
#include "epix.h"
using namespace ePiX;

const double ht = 4;

const P target=P(0,0,0);
const P observer=P(0,-4,0);
const P dtarg=P(-1,0,1);

P F(P arg)
{
  double x = arg.x2();
  return (ht/(ht+x))*P(arg.x1(), 0, arg.x3());
}

P P1 = P(0.75, -1,    -0.25);
P P2 = P(1,    -1.25, -0.75);
P P3 = P(0.5,  -1.5,  -0.5 );
P midpt = (1.0/3)*(P1+P2+P3);

main() {
  bounding_box(P(-3.5,-2.5),P(3.5,2.5));
  unitlength("0.375in");
  picture(P(7,5));

  begin();

  viewpoint(1.5,-16,3.5);
  camera.range(10);

  grid(P(-3,0,-2), P(3,0,2), 6, 8);

  masklabel(target+2*E_1, P(2,0), "\\textbf{Sea}", r);
  label(target+2*E_3, P(0,2), "\\textbf{Sky}", t);
  masklabel(target-2*E_2, P(-4,0), "\\textbf{Eye}", l);

  masklabel(observer, P(-2,0), "Viewpoint", l);
  dot(observer);

  masklabel(P(3,0,2), P(-6,-2), "Screen", bl);

  line(observer, target);

  gray(0.5);
  path temp1 = polygon(3, &F(P1), &F(P2), &F(P3));
  temp1.set_fill();
  temp1.draw();

  line(P1, F(P1));
  line(P2, F(P2));
  line(P3, F(P3));

  line(observer, F(P1));
  line(observer, F(P2));
  line(observer, F(P3));

  fill();
  gray(0.1);
  path temp2 = polygon(3, &P1, &P2, &P3);
  temp2.set_fill();
  temp2.draw();

  line(P(0.5,2,-3), midpt);
  masklabel(P(0.5,2,-3), P(0,0), "Object", b);

  line(P(2,0,-1), F(midpt));
  masklabel(P(2,0,-1), P(0,0), "Shadow", r);

  gray(1);

  masklabel(target+dtarg, P(0,0), "Target", tl);
  arrow(target+dtarg, target+0.1*dtarg);
  dot(target);

  bold();
  arrow(target, target+2*E_1);
  arrow(target, target-2*E_2);
  arrow(target, target+2*E_3);

  end();
}
