/* -*-ePiX-*- */
#include "epix.h"
using namespace ePiX;
P f(double u, double v)
{
  double x=u*Cos(v), y=u*Sin(v);
  //  return P(x, y, 0.25*x*(x*x-3*y*y));
  return P(x, y, x*y);
}

domain R(P(0,0), P(1,1), mesh(6, 18), mesh(12,60));

int main() 
{
  bounding_box(P(-1,-1),P(1,1));
  unitlength("1in");
  picture(2,2);

  begin();
  revolutions();

  camera.at(P(3, 1, 3));

  plot(f, R);

  end();
}
