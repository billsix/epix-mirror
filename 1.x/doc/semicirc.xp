/* -*-ePiX-*- */
#include "epix.h"
using namespace ePiX;
double f(double x) { return sqrt(1-x*x); }

double width = 0.6, height = f(width);
double  posn = 0.5, y_posn = f(posn);

int main() {
  picture(P(2.5, 1.25));
  unitlength("1in");
  bounding_box(P(-1, 0), P(1, 1));

  begin();

  h_axis(4);  
  v_axis(2);  
  h_axis_labels(x_size, P(0, -4), b);

  arc(P(0,0), 1, 0, M_PI);
  bold();
  rect(P(-width,0), P(width, height));

  label(P(posn, y_posn), P(2,4), "$y=\\sqrt{1-x^2}$");

  end();
}
