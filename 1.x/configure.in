dnl Process this file with autoconf to produce a configure script.
AC_INIT(globals.h)
AM_INIT_AUTOMAKE(epix, 1.0.7)

dnl Checks for programs.
#AC_PROG_CXX
AC_PROG_LN_S
AC_PROG_RANLIB
AC_PROG_MAKE_SET
AC_PROG_INSTALL

AC_SUBST(CXXFLAGS, -Wall -O2)

AC_CHECK_PROG(CXX, g++, g++)

dnl Needed by shell scripts
AC_PATH_PROG(BASH, bash, /bin/bash)

dnl For epix and flix
AC_CHECK_PROG(RUNTIME_COMPILER, g++, g++)

dnl Checks for libraries.

dnl Checks for header files.
AC_HEADER_STDC([])

dnl Checks for typedefs, structures, and compiler characteristics.
AC_C_CONST
AC_C_INLINE

dnl Checks for library functions.
AC_CHECK_FUNCS(strtod)

AC_OUTPUT(Makefile samples/Makefile contrib/Makefile doc/contrib/Makefile doc/Makefile)
