/* -*-ePiX-*- */
/* lissajous.c -- May 29, 2002 */
#include "epix.h"
using namespace ePiX;

P f(double t) { return P(ePiX::sin(3*M_PI*t+0.5), ePiX::sin(4*M_PI*t+0.5)); }

main() {

  bounding_box(P(-1,-1), P(1,1));
  picture(P(2, 2));
  unitlength("1in");
  //  offset(P(150,-180));

  begin();
  grid(2,2);
  bold();

  red();
  plot(f, 0, 2, 200);

  plain();
  blue();
  tan_field(f, 0, 2, 81);

  end();
}

