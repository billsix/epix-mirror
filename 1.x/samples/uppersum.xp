/* -*-ePiX-*- */
/* uppersum.c -- March 29, 2002 */
#include "epix.h"
using namespace ePiX;

const int N=12; // Number of rectangles
inline double f(double t) { return ePiX::sin(t); } // gather references to integrand

main() 
{
  bounding_box(P(0,0), P(3,1));
  unitlength("1in");
  picture(P(3, 1));
  offset(P(1,-1.5));

  begin();

  double dx = x_size/N;
  gray(0.1);

  for(int i=0; i < N; ++i)
    {
      double ai=x_min + i*dx;
      double bi=x_min + (i+1)*dx;

      swatch(P(ai, 0), P(bi, inf(f, ai, bi))); // shaded rectangle
      rect(P(ai, 0), P(bi, sup(f, ai, bi)));
    }

  h_axis(x_size);
  v_axis(2*y_size);

  h_axis_labels(x_size, P(0,-4), b);
  label(P(x_max, f(x_max)), P(4,0), "$y=\\sin x$", r);

  bold();    blue();
  plot(f, x_min, x_max, 40);

  end();
}

