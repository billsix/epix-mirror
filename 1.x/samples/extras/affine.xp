/* -*-ePiX-*- */
#include "epix.h"
#include "affine.h" // include the custom header
using namespace ePiX;

// October 24, 2006
//
// The instructions below assume you've copied this file and the sample
// files samples/extras/affine.cc and samples/extras/affine.h into a
// directory where you have write permission.
//
// To build affine.cc, you'll need to run commands similar to
//
//   g++ -I. -c affine.cc
//   ar -ru libaff.a affine.o
//   ranlib libaff.a
//
// Respectively, these compile affine.cc into an object file, affine.o;
// create a static library named libaff.a containing the object code;
// and create an index in libaff.a for the linker, so the library can
// be used in external programs, such as the one built from this source
// file. (On Mac OSX, you must run ranlib *after* moving the library
// file to its permanent home.)
//
// You may give the library a different name, but it MUST begin "lib" and
// have the extension ".a": "libblug.a" and "libaff-1.0.a" are all right,
// but "mylib.a" or "libaffine.test" are not. You refer to the library by
// its name with "lib" and ".a" removed, as in "blug" or "aff-1.0".
//
// To compile this source file (the one you're reading now), build libaff.a
// as described above, then run the command
//
//   epix -I. -L. -laff affine.xp
//
// Files (such as this one) that use an external library cannot be compiled
// from emacs, since there is no way to pass the required options; they must
// be compiled at a shell prompt.
//
// Please consult the gcc documentation ("g++ --help") for information on
// what each option does.


// About the features of this file:
//
// The function std_F draws the image of an "F" in the unit square
// under the plane affine transformation x -> Ax + b. The arguments 
// are the columns of A, the constant b, the background shade of gray
// (see affine.h for choices), and the foreground shade. Default
// values are shown.
//
// std_F(A1=P(1,0), A2=P(0,1), b=P(0,0), back=WHITE, fore=BLACK);
//
// "F" is the first letter of the Roman alphabet that has no non-trivial
// symmetries.

int main()
{
  bounding_box(P(0,0), P(6,6));
  unitlength("1in");
  picture(4,4);

  begin();

  grid(6,6);

  std_F(); // the standard F

  std_F(P(1,2), P(2,2), P(2,1), GRAY10, GRAY60); // and two images

  std_F(P(-sqrt(3),1), P(0,-2), P(2,5), GRAY60, WHITE);

  bold();
  red(); // both shades must be NONE in order to use color
  std_F(P(1,1), P(-1,1), P(5,0), NONE, NONE);

  end();
}
