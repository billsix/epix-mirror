/* -*-ePiX-*- */
/* golden_rect.c -- March 28, 2002 */
#include "epix.h"
using namespace ePiX;

const double tau = (1+sqrt(5))/2;

int main() 
{
  bounding_box(P(0,0), P(tau,1));
  picture(100*(1+tau), 100*tau);
  unitlength("0.0125in");

  //  offset(120,-80);

  begin();

  dashed();
  line(P(0.5,0), P(0.5,1));

  solid();
  line(P(1,0), P(1,1));
  line(P(0.5,0), P(1,1));

  arc(P(0.5,0), tau-0.5, 0, Atan(2.0));
  
  bold();
  rect(P(0,0), P(tau, 1));

  end();
}

