/* -*-ePiX-*- */
/* heightfield.cc -- December 03, 2002 */
#include <epix.h>
using namespace ePiX;

const int MAX=20;

double f(double u, double v)
{
  return 0.25*(1+pow(Cos(0.5*sqrt(u*u+(v-10)*(v-10))),2)
    + pow(Cos(0.5*sqrt(u*u+(v+10)*(v+10))),2));
}

int main()
{
  picture(1,1);
  bounding_box(P(-MAX,-MAX), P(MAX,MAX));
  unitlength("1in");

  begin();
  //  viewpoint(-2,0,5);
  camera.range(30);

  fill();
  for (int i=-MAX; i<=MAX; ++i)
    for (int j=-MAX; j<=MAX; ++j)
      {
	gray(f(i,j));
	rect(P(i-0.5,j-0.5), P(i+0.5,j+0.5));
      }

  fill(false);

  red;
  rect(P(x_min, y_min), P(x_max, y_max));
  end(); 
}
