/* -*-ePiX-*- */
/* koch.c -- May 29, 2002 */
#include "epix.h"
using namespace ePiX;

const int koch_seed[] = {6, 4, 0, 1, -1, 0};

int main() 
{
  bounding_box(P(-1,-1), P(1, 1));
  picture(2,2);
  unitlength("1in");

  degrees();
  for (int i=4; i <= 4; ++i)
    {
      begin();   

      fractal(cis(150), cis( 30), i, koch_seed);
      fractal(cis( 30), cis(-90), i, koch_seed);
      fractal(cis(-90), cis(150), i, koch_seed);

      if (i==1)
        {
          bold();
          red();
          fractal(cis(150), cis(30), i, koch_seed);
          black();
          plain();
        }
      end();
    }
}

