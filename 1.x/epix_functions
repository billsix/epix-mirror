# Common functions for ePiX's shell scripts
#
PROG=$(basename $0)

function ePiX_die {
    echo "$PROG: ERROR: $1" >&2
    exit 1
}

function ePiX_warn {
    echo "$PROG: WARNING: $1" >&2
}


function ePiX_basic_help()
{
cat <<HELP >&1
Usage: $PROG [options] <file(s)>[$1]

Options:
    -h, --help
      Show this message and exit

    -v, --version
      Show version and exit

HELP
} # End of ePiX_basic_help


function ePiX_terse_help()
{
cat <<TERSE >&1
  For options specific to $PROG, do

    $PROG --verbose -h

TERSE
} # End of ePiX_terse_help

function ePiX_version 
{
    my_decode="tr '[a-m][n-z]' '[n-z][a-m]'" # Mac OS X has no 'rot'
    SPAMMY="<$(echo nujnat|$my_decode)@$(echo zngupf|$my_decode)."
    SPAMMY="${SPAMMY}$(echo ubylpebff|$my_decode).$(echo rqh|$my_decode)>"

cat <<VERSION >&1
$PROG is part of ePiX, Version EPIX_VERSION_NUMBER

Copyright (C) 2001, 2002, 2003, 2004, 2005
Andrew D. Hwang  $SPAMMY
Department of Mathematics and Computer Science
College of the Holy Cross
Worcester, MA, 01610-2395, USA

VERSION
} # end of ePiX_version

