#!/bin/bash
#
# make_laps -- Generate shell script "laps" from config
#
# Andrew D. Hwang <"laps -v" for email>
#
# May 07, 2005
#

## Don't modify anything below unless you know what you're doing :) ##

LAPS_WRAPPER=laps

source ./config || ( echo "Can't find config file" && exit 1 )

## Unquoted HERE document ##
cat <<HEADER > $LAPS_WRAPPER
#!/bin/bash
#
# laps: latex to Postscript/PDF
#
# Options: --help for usage, --version for version and license
#
# Copyright (C) 2001, 2002, 2003, 2004, 2005
# Andrew D. Hwang   <For address, do "laps -v">
# 

## Auto-generated file; modify as necessary ##

HEADER
# End of header

# Common functions
cat epix_functions >> $LAPS_WRAPPER

# Now for phase two...
cat <<"EOF" >> $LAPS_WRAPPER
PROG=$(basename $0)
DVIPS_OPTS="-f"

LAPS_FILE_LIST=""
declare -i LAPS_FILE_COUNT

LAPS_VERBOSE="no"
LAPS_PREFIX="la"
LAPS_STDERR=/dev/null
LAPS_PDF=

LAPS_EXTENSIONS="tex dtx ltx" # or NULL
LAPS_DOT_EXT=".${LAPS_EXTENSIONS// /|.}" # for usage message
LAPS_DEFAULT_EXT="tex"

function laps_parse_options {
# Command-line options start with "-"
while [ "$1" != "${1#"-"}" ]; do
    case "$1" in
 
        -vv|--verbose)
            LAPS_VERBOSE="yes"
            LAPS_STDERR=/dev/stderr
            shift;
            ;;

        -h|--help)
	    ePiX_basic_help $LAPS_DOT_EXT && laps_help && exit 0
	    ;;

        -v|--version)
            ePiX_version &&
            if [ "$LAPS_VERBOSE" = "yes" ]; then 
                ePiX_license
            else
                echo "$PROG --verbose -v\" for license" 
            fi && 
            exit 0
	    ;;

        -n|--no-config) # do not use ~/.dvipsrc
            export DVIPSRC=/dev/null
            shift;
            ;;

        -ps|--ps)
            LAPS_PREFIX="psla";
            shift;
            ;;

        --pdftex)
            LAPS_PREFIX="pdf";
            LAPS_PDF="";
            shift;
            ;;

        --pdflatex)
            LAPS_PREFIX="pdfla";
            LAPS_PDF="";
            shift;
            ;;

        -pdf|--pdf)
            LAPS_PREFIX=${LAPS_PREFIX##"pdf"};
            LAPS_PDF="yes";
            shift;
            ;;

        -P*)
            DVIPS_OPTS="$1 $DVIPS_OPTS";
            shift;
            ;;

        -t|--tex)
            LAPS_PREFIX="";
            shift;
            ;;

        *)
            ePiX_warn "Ignoring unknown option \"$1\"";
            shift;
            ;;
    esac
done

LAPS_FILE_LIST=$@
LAPS_FILE_COUNT=$#
} # End of laps_parse_options


function laps_compile ()
{
    LAPS_INFILE=$1
    LAPS_INROOT=""
    LAPS_EXT=""

    # search extensions; first match wins
    for EXT in $LAPS_EXTENSIONS; do
        TMP_ROOT=${LAPS_INFILE%%".$EXT"}
        if [ $LAPS_INFILE = $TMP_ROOT.$EXT ]; then
            LAPS_INROOT=$TMP_ROOT && LAPS_EXT=$EXT && break;
        fi
    done

    # No recognized extension provided, assume default
    if [ "$LAPS_EXT" = "" ]; then
        LAPS_INROOT=${LAPS_INFILE%%"."}
        LAPS_EXT=$LAPS_DEFAULT_EXT
    fi

    if [ ! -f $LAPS_INROOT.$LAPS_EXT ]; then
        ePiX_warn "\"$LAPS_INROOT.$LAPS_EXT\" not found, skipping"
    else
        ${LAPS_PREFIX}tex $LAPS_INROOT.$LAPS_EXT 1> $LAPS_STDERR
        dvips $DVIPS_OPTS -o $LAPS_INROOT.ps $LAPS_INROOT.dvi &> $LAPS_STDERR
        if [ "$LAPS_PDF" = "yes" ]; then 
            ps2pdf $LAPS_INROOT.ps &> $LAPS_STDERR; 
        fi
    fi
}


function laps_help ()
{
cat <<"HELP" >&1
    -vv, --verbose
      Show output/error messages, or license (before -v)

    --pdf(la)tex
      Use pdf(la)tex instead of latex.

    --pdf
      Post-process ps file with ps2pdf

    -ps, --ps
      Use pslatex instead of latex.

    -P<printer>
      dvips printer options, e.g. "-Pamz", may be given on the command 
      line. They are also read from ~/.dvipsrc if this file exists.

    -n, --no-config
      Ignore $(HOME)/.dvipsrc

    -t, --tex
      Use tex instead of latex

HELP
} # End of laps_help

### main ###

if [ $# -eq 0 ]; then
        ePiX_basic_help $LAPS_DOT_EXT && laps_help && exit 0
else
    laps_parse_options $@
    if [ $LAPS_FILE_COUNT -eq 0 ]; then
        ePiX_die "You must specify an input file!"
    else
        for FILE in $LAPS_FILE_LIST; do
            laps_compile $FILE
        done
    fi

fi

exit 0

EOF

chmod 700 $LAPS_WRAPPER
## end of script ##
