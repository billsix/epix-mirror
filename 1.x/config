# Set these variables before building
#

######  Install directory  ######

## Uncomment only one, beware of trailing spaces.

EPIX_ROOTDIR=/usr/local

#EPIX_ROOTDIR=/opt
#EPIX_ROOTDIR=/sw
#EPIX_ROOTDIR=${HOME}


######  Runtime compiler  ######

## Use full path if necessary, see Makefile for build compiler.

EPIX_CXX=g++

#EPIX_CXX=/usr/local/bin/g++-3.4


######  Bash  ######

## GNU/Linices should leave this alone

EPIX_BASH_PATH=/bin/bash

#EPIX_BASH_PATH=/sw/bin/bash
#EPIX_BASH_PATH=/usr/local/bin/bash


###### Modify below at your own risk ######

EPIX_VERSION=EPIX_VERSION_NUMBER


## Relative locations of installed components

# config files, notes
EPIX_SHR_DIR=share/epix

# samples, manual
EPIX_DOC_DIR=share/doc/epix

# man page
EPIX_MAN_DIR=share/man/man1


## FHS directories where we install files; removed at uninstall if empty
EPIX_TOP_DIRS="bin lib include share/man/man1 share/man share/doc share"


## Our share directories; contents forcibly removed at uninstall
EPIX_SUB_DIRS="$EPIX_SHR_DIR/config $EPIX_SHR_DIR/notes \
               $EPIX_SHR_DIR $EPIX_DOC_DIR"


EPIX_SHR_PATH=${EPIX_ROOTDIR}/${EPIX_SHR_DIR}
EPIX_DOC_PATH=${EPIX_ROOTDIR}/${EPIX_DOC_DIR}
EPIX_MAN_PATH=${EPIX_ROOTDIR}/${EPIX_MAN_DIR}

EPIX_NOTE_PATH=${EPIX_ROOTDIR}/${EPIX_SHR_DIR}/notes
EPIX_CONF_PATH=${EPIX_ROOTDIR}/${EPIX_SHR_DIR}/config
