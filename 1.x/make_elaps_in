PROG=$(basename $0)

## Nothing below here should need modification ##

EPIX_CONFIG_FILE="$HOME/.epixrc"
# Search these extensions in order of preference
ELAPS_EXTENSIONS="eepic xp flx cc c C cpp" # or NULL
ELAPS_DOT_EXT=".${ELAPS_EXTENSIONS// /|.}" # for usage message

# default options
DVIPS_OPTS="-f"
ELAPS_PKGS="latexsym,amsmath,rotating,epic,eepic,pstcol"
ELAPS_SIZE=12 # figure compiled in [12pt]{article}

ELAPS_PDF="no"    # Create PDF file?
ELAPS_PS="no"     # Create PS file instead of EPS?

ELAPS_STDERR=/dev/null # Pipe stderr here
ELAPS_VERBOSE="no"
EPIX_OPTS=""

LATEX_INTERACT="batchmode"

# auxiliary programs
PS2EPS="ps2epsi"

# internal filenames
PID=$$
ELAPS_TEMP_EEPIC=$PROG-$PID.eepic
ELAPS_TEMP_LATEX=$PROG-$PID.tex
ELAPS_TEMP_DVI=$PROG-$PID.dvi
ELAPS_TEMP_PS=$PROG-$PID.ps
ELAPS_TEMP_EPSI=$PROG-$PID.epsi

# globals to pass tokens
ELAPS_INFILE=""
ELAPS_INROOT=""
ELAPS_OUTROOT=""
ELAPS_USER_OUT="no" # user specified output file?
FOUND_EXT=""


function elaps_help()
{
cat <<"HELP" >&1
Options:
    -h, --help
      Show this message and exit

    -v, --version
      Show version and exit

    -vv, --verbose
      Scroll output/error messages, or show license (before -v)

    -n, --no-config
      Ignore $(HOME)/.dvipsrc

    -o|--output
      Specify output file (ONLY for use with a single input file)

    -p, --pkg <LaTeX package>
      Use an additional LaTeX package in the temporary LaTeX file, e.g. 
      "-p floatflt". Multiple packages are specified one per "-p" flag.

    -pdf, --pdf
      Create PDF file instead of EPS

    -ps, --ps
      Create standalone PostScript file (overrides --pdf)

    -P<printer>
      dvips printer options, e.g. "-Pamz", may be given on the command 
      line. They are also read from ~/.dvipsrc if this file exists.

    --size
      Set default font size: 10, 11, or 12 (default)

    Other options are passed to epix (q.v.).

HELP
} # End of elaps_help

# Generate US letter-friendly LaTeX file
function elaps_make_latex ()
{
cat <<LaTeX >> $1
\documentclass[${2}pt]{article}
\usepackage{$3}
\setlength{\textwidth}{7.5in}
\setlength{\textheight}{9.5in}
\setlength{\oddsidemargin}{-0.5in}
\setlength{\topmargin}{0in}
\pagestyle{empty}

\begin{document}
\begin{center}
\input{$4}
\end{center}
\end{document}

LaTeX
} # End of elaps_make_latex


function elaps_get_options ()
{
    while [ "$1" != "${1#"-"}" ]; do 
        case "$1" in

        -h|--help)
	    ePiX_usage $ELAPS_DOT_EXT && elaps_help && exit 0
	    ;;

        -n|--no-config) # do not use ~/.dvipsrc
            export DVIPSRC=/dev/null
            shift;
            ;;

        -o|--output)
            if [ $2 = ${2%%"eps"}eps ]; then
                ELAPS_OUTROOT=${2%%".eps"}

            elif [ $2 = ${2%%"pdf"}pdf ]; then
                ELAPS_PDF="yes" 
                ELAPS_OUTROOT=${2%%".pdf"}

            else
                ELAPS_OUTROOT=$2
            fi
            ELAPS_USER_OUT="yes"
            shift 2;
            ;;

        -P*)
            DVIPS_OPTS="$DVIPS_OPTS $1";
            shift;
            ;;

        -pdf|--pdf)
            ELAPS_PDF="yes"
            shift;
            ;;

        -ps|--ps)
            ELAPS_PS="yes"
            ELAPS_PDF="no" # redundant; enforced by logic later
            shift;
            ;;

        -p|--pkg)
            if [ "$2" != "${2#"-"}" ]; then
                elaps_warn "\"$1\" cannot be followed by \"$2\"; skipping"
                shift 1;
            else
                ELAPS_PKGS="$ELAPS_PKGS,$2"
                echo "$PROG: Using LaTeX package \"$2\"" > $ELAPS_STDERR
                shift 2;
            fi
            ;;

        -p*)
            ELAPS_PKGS="$ELAPS_PKGS,${1#"-p"}"
            shift;
            ;;

        --size)
            ELAPS_SIZE=$2
            shift 2;
            ;;

        -v|--version)
            ePiX_version
            if [ "$ELAPS_VERBOSE" = "yes" ]; then
                ePiX_license
            else
                echo "$PROG --verbose -v\" for license"
            fi
            exit 0
	    ;;

        -vv|--verbose)
            ELAPS_VERBOSE="yes"
            ELAPS_STDERR=/dev/stderr
            LATEX_INTERACT="scrollmode"
            shift;
            ;;

        # pass other options to epix
        -V|-i*|-u|-x|-I|-L|-l|-W)
	    EPIX_OPTS="$EPIX_OPTS $1 $2";
            shift 2;
            ;;

        -b) 
            ePiX_warn "Skipping option \"$1 $2\""
            shift 2;
            ;;

        *)
            EPIX_OPTS="$EPIX_OPTS $1";
            shift;
            ;;
        esac
    done

    # Assume remaining parameters are input files
    INFILE_COUNT=$#

    if [ $INFILE_COUNT -eq 0 ]; then ePiX_die "No input file specified"; fi

    if [ "$ELAPS_USER_OUT" = "yes" -a $INFILE_COUNT -gt 1 ]; then
        shift $((INFILE_COUNT - 1))
        INFILE_LIST=$@
        ePiX_warn "Output file specified with multiple input files. Skipping all but \"$INFILE_LIST\""
    fi

    INFILE_LIST=$@

} # end of elaps_get_options()


# Gets ELAPS_INROOT and FOUND_EXT, or sets ELAPS_INROOT="" if file not found
function elaps_parse_filename()
{
    # initialize global variables
    ELAPS_INROOT=""
    FOUND_EXT=""
    FOUND_CT=0

    MY_INFILE=$1

    # check for recognized extension
    for EXT in $ELAPS_EXTENSIONS; do
        TMP_ROOT=${MY_INFILE%".$EXT"}
        if [ $MY_INFILE = $TMP_ROOT.$EXT ]; then # got a match
            ELAPS_INROOT=$TMP_ROOT
            FOUND_EXT=$EXT
            break
        fi
    done

    # Extension found
    if [ "$FOUND_EXT" != "" ]; then
        if [ ! -f $MY_INFILE ]; then
            ePiX_warn "\"$MY_INFILE\" not found"
            ELAPS_INROOT=""
        fi

        return

    else # No match, look for completions
        ELAPS_INROOT=${MY_INFILE%"."} # strip trailing dot, if any

        # Search for (and count) completions; first match wins
        for EXT in $ELAPS_EXTENSIONS; do
            if [ -f $ELAPS_INROOT.$EXT ]; then 
                if [ $FOUND_CT -eq 0 ]; then  # first match
                    FOUND_EXT=$EXT
                fi

                let FOUND_CT=FOUND_CT+1
            fi
        done

        if [ $FOUND_CT -eq 0 ]; then
            ePiX_warn "No completion of \"$ELAPS_INROOT\" found"
            ELAPS_INROOT=""
            return

        elif [ $FOUND_CT -ge 2 ]; then
            ePiX_warn "Found $FOUND_CT completions of \"$ELAPS_INROOT\", using $ELAPS_INROOT.$FOUND_EXT"

        # else one file found
        fi

    fi # if $FOUND_EXT!=""

} # end of elaps_parse_filename()


function elaps_process_file() 
{
    ELAPS_INFILE=$1

    if [ "$ELAPS_VERBOSE" = "yes" ]; then echo "$ELAPS_INFILE"; fi

    elaps_parse_filename $ELAPS_INFILE

    if [ "$ELAPS_INROOT" = "" ]; then 
        return

    elif [ "$ELAPS_USER_OUT" = "no" ]; then
        ELAPS_OUTROOT=$ELAPS_INROOT

    fi

    MY_INFILE=$ELAPS_INROOT.$FOUND_EXT # known to exist if we're here

    # Create eepic file if necessary
    if [ "$FOUND_EXT" != "eepic" ]; then
        TMP_CMD="$EPIX_BIN $EPIX_OPTS -o $ELAPS_TEMP_EEPIC $MY_INFILE"

        $TMP_CMD 2> $ELAPS_STDERR
        if [ $MY_INFILE -nt $ELAPS_TEMP_EEPIC ]; then
            ePiX_warn "\"$TMP_CMD\" failed"
            return
        fi

    else
        ln -s $MY_INFILE $ELAPS_TEMP_EEPIC

    fi

    elaps_make_latex $ELAPS_TEMP_LATEX $ELAPS_SIZE $ELAPS_PKGS \
        $ELAPS_TEMP_EEPIC

    # Create $ELAPS_TEMP_PS
    TMP_CMD="latex -interaction=$LATEX_INTERACT $ELAPS_TEMP_LATEX"

    $TMP_CMD 1>$ELAPS_STDERR
    if [ ! -f $ELAPS_TEMP_DVI ]; then
        ePiX_warn "\"$TMP_CMD\" failed"
        return
    fi

    TMP_CMD="dvips $DVIPS_OPTS -o $ELAPS_TEMP_PS $ELAPS_TEMP_DVI"

    $TMP_CMD &>$ELAPS_STDERR
    if [ ! -f $ELAPS_TEMP_PS ]; then
        ePiX_warn "\"$TMP_CMD\" failed"
        return
    fi

    if [ "$ELAPS_PS" = "yes" ]; then
        # fix title
        sed "s/$PROG-$PID/$ELAPS_INROOT/g" $ELAPS_TEMP_PS > $ELAPS_OUTROOT.ps

    else
        # Create eps file,
        $PS2EPS $ELAPS_TEMP_PS 1> $ELAPS_STDERR

        # fix title,
        sed "s/$PROG-$PID/$ELAPS_INROOT/g" \
            $ELAPS_TEMP_EPSI > $ELAPS_OUTROOT.eps &&
        rm $ELAPS_TEMP_EPSI

        # create pdf if requested,
        if [ "$ELAPS_PDF" = "yes" ]; then
            # avoid ghostscript rotation bug
            grep -v "^%%Orientation:" $ELAPS_OUTROOT.eps | \
                epstopdf --filter --outfile=$ELAPS_OUTROOT.pdf
            rm $ELAPS_OUTROOT.eps # clean up eps
        fi
    fi

    # and clean up
    rm  $ELAPS_TEMP_LATEX $ELAPS_TEMP_DVI $ELAPS_TEMP_PS \
        $ELAPS_TEMP_EEPIC $PROG-$PID.aux $PROG-$PID.log

} # elaps_process_file()

## Script proper starts here ##

if [ $# -eq 0 ]; then 
    ePiX_usage $ELAPS_DOT_EXT
    ePiX_terse_help
    exit 0

else
    elaps_get_options $@

    for INFILE in $(echo $INFILE_LIST); do
        elaps_process_file $INFILE
    done
fi

exit 0
